{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parking:schema:stage-0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registrations",
    "accessible",
    "pools"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "registrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "household",
              "motorcycle",
              "bicycleLarge",
              "bicycleSmall"
            ],
            "properties": {
              "household": {
                "type": "string",
                "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
              },
              "motorcycle": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "bicycleLarge": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "bicycleSmall": {
                "enum": [
                  0,
                  1,
                  2
                ]
              }
            }
          }
        },
        "B": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "household",
              "motorcycle",
              "bicycleLarge",
              "bicycleSmall"
            ],
            "properties": {
              "household": {
                "type": "string",
                "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
              },
              "motorcycle": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "bicycleLarge": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "bicycleSmall": {
                "enum": [
                  0,
                  1,
                  2
                ]
              }
            }
          }
        }
      }
    },
    "accessible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignments",
        "splitSpaces",
        "transferredSpaces"
      ],
      "properties": {
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "household",
              "spaceId"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "household": {
                "type": "string",
                "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
              },
              "spaceId": {
                "enum": [
                  "14",
                  "2",
                  "3"
                ]
              }
            }
          }
        },
        "splitSpaces": {
          "type": "array",
          "items": {
            "enum": [
              "2",
              "2-1",
              "3",
              "3-1",
              "14",
              "14-1"
            ]
          }
        },
        "transferredSpaces": {
          "type": "array",
          "items": {
            "enum": [
              "86",
              "87",
              "88"
            ]
          }
        }
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "urn:parking:schema:draw-pools#/$defs/pool"
          },
          {
            "properties": {
              "candidates": {
                "items": {
                  "$ref": "urn:parking:schema:draw-pools#/$defs/space"
                }
              }
            }
          }
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "properties": {
            "id": {
              "const": "motorcycle_a"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "motorcycle_b"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "bicycle_large"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "bicycle_small"
            }
          }
        }
      ]
    }
  },
  "title": "Stage 0: confirmed registration and first-round pools"
}
