{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parking:schema:activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activityId",
    "activityYear",
    "mode",
    "createdAt",
    "createdByAppVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "activityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "activityYear": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "test",
        "live"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdByAppVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "currentStage": {
      "type": "integer",
      "minimum": -1,
      "maximum": 6,
      "description": "Optional legacy progress hint; never used as the recovery authority."
    }
  }
}
